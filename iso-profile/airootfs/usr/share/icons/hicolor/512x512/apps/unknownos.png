<?xml version="1.0" encoding="UTF-8"?>
<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="iconBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#050510;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a0a1a;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="iconGlow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" style="stop-color:#007aff;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#007aff;stop-opacity:0" />
    </radialGradient>
    <radialGradient id="iconIndiaGlow" cx="20%" cy="80%" r="30%">
      <stop offset="0%" style="stop-color:#138808;stop-opacity:0.2" />
      <stop offset="100%" style="stop-color:#138808;stop-opacity:0" />
    </radialGradient>
    <radialGradient id="iconSaffronGlow" cx="80%" cy="80%" r="30%">
      <stop offset="0%" style="stop-color:#ff9933;stop-opacity:0.2" />
      <stop offset="100%" style="stop-color:#ff9933;stop-opacity:0" />
    </radialGradient>
  </defs>

  <rect width="512" height="512" rx="96" fill="url(#iconBg)"/>
  <ellipse cx="256" cy="204" rx="260" ry="180" fill="url(#iconGlow)"/>
  <ellipse cx="102" cy="410" rx="100" ry="60" fill="url(#iconIndiaGlow)"/>
  <ellipse cx="410" cy="410" rx="100" ry="60" fill="url(#iconSaffronGlow)"/>

  <text x="256" y="260" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="112" font-weight="700" fill="#ffffff" letter-spacing="4">U</text>
  <text x="256" y="356" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="64" font-weight="200" fill="#007aff" letter-spacing="4">OS</text>
  <line x1="128" y1="296" x2="384" y2="296" stroke="#007aff" stroke-width="4" opacity="0.5"/>
</svg>